# Webhook Configuration
WEBHOOK_TARGET_URL=
SHARED_SECRET=dev-secret-change-in-production

# Database
DATABASE_URL=sqlite:///./university_portal.db

# Scheduler
SCHEDULER_TIMEZONE=UTC

# Webhook retry settings
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAYS=5,30,120

# App settings
APP_NAME=University Portal Simulator
DEBUG=true
EXAM_REMARK_WEBHOOK_API_KEY=test-webhook-key
GRADES_LOOKUP_API_KEY=test-grades-key


# n8n attendance end-of-day workflow
N8N_ATTENDANCE_WEBHOOK_URL=http://34.123.5.126:5678/webhook/attendance-end-of-day
N8N_WARNING_STATUS_URL=http://34.123.5.126:5678/webhook/student-warning-status
