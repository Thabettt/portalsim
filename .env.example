# Webhook Configuration
WEBHOOK_TARGET_URL=http://localhost:8080/webhook
SHARED_SECRET=your-shared-secret-change-in-production
N8N_ATTENDANCE_WEBHOOK_URL=https://your-n8n-domain/webhook/attendance-end-of-day
N8N_INTERNSHIP_STATUS_WEBHOOK_URL=https://your-n8n-domain/webhook/internship-status-change
N8N_PROGRESS_REPORT_STATUS_WEBHOOK_URL=https://your-n8n-domain/webhook/progress-report-status-change

# Database
DATABASE_URL=sqlite:///./university_portal.db

# Scheduler
SCHEDULER_TIMEZONE=UTC

# Webhook retry settings
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAYS=5,30,120

# Attendance end-of-day chunked submission
# Students per POST to the n8n attendance webhook
ATTENDANCE_CHUNK_SIZE=200
# Max chunk requests in flight at once
ATTENDANCE_CHUNK_MAX_CONCURRENCY=5
# Retries per chunk after the initial attempt
ATTENDANCE_CHUNK_MAX_RETRIES=3
# Exponential backoff between chunk retries (seconds)
ATTENDANCE_CHUNK_RETRY_DELAYS=2,4,8
ATTENDANCE_CHUNK_TIMEOUT_SECONDS=30

# App settings
APP_NAME=University Portal Simulator
DEBUG=true
